{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Ouriel Tapiero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otapiero/AgentWorkflowDashboard.git"
  },
  "bugs": {
    "url": "https://github.com/otapiero/AgentWorkflowDashboard/issues"
  },
  "homepage": "https://github.com/otapiero/AgentWorkflowDashboard#readme",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "github",
    "worktree",
    "orchestration"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "win32"
  ],
  "type": "module",
  "description": "A local cockpit for driving AI coding agents through a GitHub issue-to-merge pipeline",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --import tsx src/server/index.ts",
    "mc": "tsx src/orchestrator/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "extension:install-deps": "npm --prefix vscode-extension ci",
    "extension:verify": "npm --prefix vscode-extension run verify",
    "extension:test-host": "npm --prefix vscode-extension run test:extension",
    "extension:package": "npm --prefix vscode-extension run package"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@modelcontextprotocol/server": "2.3.1",
    "execa": "^9.6.0",
    "fastify": "^5.4.0",
    "js-yaml": "^4.1.0",
    "marked": "^18.0.7",
    "proper-lockfile": "4.1.2",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "^1.64.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.10",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
